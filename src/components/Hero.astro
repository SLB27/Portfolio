---
import { site } from "../data/portfolio";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
---
<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-photo reveal">
      <div class="photo-frame">
        <img
          src={site.avatar}
          alt={`Foto de ${site.name}`}
          width="480"
          height="480"
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-text reveal">
      <p class="hero-greeting">
        <span class="dot"></span> Hola, soy
      </p>
      <h1 class="hero-name">
        {site.firstName} <span class="accent">{site.lastName}</span>
      </h1>
      <p class="hero-role">{site.role}</p>
      <p class="hero-tagline">{site.tagline}</p>

      <div class="hero-buttons">
        <a
          href={site.github}
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GitHubIcon />
          GitHub
        </a>
        <a
          href={site.linkedin}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkedInIcon />
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  <a href="#sobre-mi" class="scroll-hint" aria-label="Ir a la sección Sobre mí">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-height) + 2rem);
    padding-bottom: 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-photo {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    position: relative;
    width: min(320px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, var(--red), var(--red-dark) 60%, transparent);
    box-shadow: 0 0 0 6px rgba(255, 43, 58, 0.08), var(--shadow-red);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--bg);
  }

  .hero-greeting {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--red);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 12px var(--red);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 0.5rem;
  }

  .hero-name .accent {
    color: var(--red);
  }

  .hero-role {
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .hero-tagline {
    color: var(--text-muted);
    font-size: 1.08rem;
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid var(--text-dim);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
    opacity: 0.7;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .scroll-hint:hover {
    border-color: var(--red);
    opacity: 1;
  }

  .scroll-hint span {
    width: 4px;
    height: 8px;
    border-radius: 4px;
    background: var(--red);
    animation: scroll 1.8s ease-in-out infinite;
  }

  @keyframes scroll {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + 3rem);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      text-align: center;
    }

    .hero-tagline {
      margin-inline: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>
